# ---- API ----
NODE_ENV=development
API_PORT=3333
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# ---- Postgres ----
POSTGRES_USER=sgi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sgi_ceara
DATABASE_URL=postgresql://sgi:change-me@localhost:5432/sgi_ceara?schema=public

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=change-me
COOKIE_SECURE=false

# ---- Storage S3-compatible (MinIO em dev / R2 em producao) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sgi-ceara
S3_ACCESS_KEY=sgi
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@cearaalimentos.com.br
SEED_ADMIN_PASSWORD=Trocar@123

# ---- Integracoes de saida (F10) ----
# Ausentes, o canal fica declarado como NAO CONFIGURADO e a fila espera.
# Nada e marcado como enviado sem ter saido.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_SEGURO=false
SMTP_REMETENTE=SGI Ceara <nao-responda@cearaalimentos.com.br>

# WhatsApp e canal de SAIDA apenas (secao 5.5)
WHATSAPP_URL=
WHATSAPP_TOKEN=

# Consulta de NF-e por chave: exige certificado digital A1 da empresa
SEFAZ_URL=
SEFAZ_CERTIFICADO=

# ---- Web ----
VITE_API_URL=http://localhost:3333

# Oracle do WinThor - so leitura da PCEMPR para o login (mesmo usuario do BI de comissao).
# Vazio: so o login por e-mail funciona.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
