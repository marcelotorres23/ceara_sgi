{
  "name": "@sgi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node20 --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "db:seed-teste-regua": "dotenv -e ../../.env -- tsx src/db/seed-teste-regua.ts",
    "smoke:regua": "dotenv -e ../../.env -- tsx src/db/smoke-regua.ts",
    "db:importar-rotas": "dotenv -e ../../.env -- tsx src/db/importar-rotas.ts",
    "smoke:f7": "dotenv -e ../../.env -- tsx src/db/smoke-f7.ts",
    "smoke:f8": "dotenv -e ../../.env -- tsx src/db/smoke-f8.ts",
    "smoke:f9": "dotenv -e ../../.env -- tsx src/db/smoke-f9.ts",
    "smoke:f10": "dotenv -e ../../.env -- tsx src/db/smoke-f10.ts",
    "smoke:solicitacoes": "dotenv -e ../../.env -- tsx src/db/smoke-solicitacoes.ts",
    "smoke:cotacoes": "dotenv -e ../../.env -- tsx src/db/smoke-cotacoes.ts",
    "smoke:tanque": "dotenv -e ../../.env -- tsx src/db/smoke-tanque.ts",
    "db:importar-periodicos": "dotenv -e ../../.env -- tsx src/db/importar-servicos-periodicos.ts",
    "smoke:periodicos": "dotenv -e ../../.env -- tsx src/db/smoke-periodicos.ts",
    "smoke:baterias": "dotenv -e ../../.env -- tsx src/db/smoke-baterias.ts",
    "smoke:pessoas": "dotenv -e ../../.env -- tsx src/db/smoke-pessoas-painel.ts",
    "smoke:rel-abastecimento": "dotenv -e ../../.env -- tsx src/db/smoke-relatorio-abastecimento.ts",
    "smoke:entrada-xml": "dotenv -e ../../.env -- tsx src/db/smoke-entrada-xml.ts",
    "smoke:perfis": "dotenv -e ../../.env -- tsx src/db/smoke-perfis.ts"
  },
  "prisma": {
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.28.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.4.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^2.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.3",
    "oracledb": "^6.10.0",
    "pdfkit": "^0.15.2",
    "pino": "^9.5.0",
    "uuidv7": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/oracledb": "^26.0.1",
    "@types/pdfkit": "^0.17.6",
    "dotenv-cli": "^7.4.4",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
