{
  "name": "sgi-ceara",
  "private": true,
  "version": "0.1.0",
  "description": "SGI Ceara - Sistema de Gestao Integrada Ceara Alimentos",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @sgi/api",
    "dev:web": "npm run dev -w @sgi/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @sgi/api",
    "db:seed": "npm run db:seed -w @sgi/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.41.1": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@5.22.0": true
  }
}
